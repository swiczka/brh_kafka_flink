# Skopiuj do .env (cp .env.example .env) i zmień hasła. Plik .env nie trafia do gita.
KAFKA_ADMIN_PASSWORD=admin-secret
KAFKA_PRODUCER_PASSWORD=producer-secret
KAFKA_FLINK_PASSWORD=flink-secret
KAFKA_UI_PASSWORD=ui-secret
SILO_ROOT_USER=siloadmin
SILO_ROOT_PASSWORD=silo-secret-123
